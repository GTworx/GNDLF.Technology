# GNDLF iletişim formu — ORTAM DEĞİŞKENLERİ (ÖRNEK)
# Bu dosya örnektir; gerçek anahtarı BURAYA YAZMAYIN ve COMMIT'LEMEYİN.
# Değerleri barındırma panelinizde (Vercel/Netlify) tanımlayın.

# Brevo API anahtarınız (https://app.brevo.com/settings/keys/api) — ZORUNLU
BREVO_API_KEY=

# Ana site iletişim formunun gideceği e-posta(lar), virgülle ayrılmış
# (varsayılan: oya@gndlf.io,gokhan@gndlf.io)
CONTACT_TO=oya@gndlf.io,gokhan@gndlf.io

# PMO Cockpit formunun gideceği e-posta(lar), virgülle ayrılmış
# (varsayılan: gokhan@gndlf.io,oya@gndlf.io,sales@gndlf.io,pmocockpit@gndlf.io)
CONTACT_TO_PMO=gokhan@gndlf.io,oya@gndlf.io,sales@gndlf.io,pmocockpit@gndlf.io

# Gönderen adresi. Kendi alan adınızı Brevo'da doğruladıktan sonra kullanın,
# örn: "GNDLF Web <info@gndlf.io>".
CONTACT_FROM=GNDLF Web <info@gndlf.io>
