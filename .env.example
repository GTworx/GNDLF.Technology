# GNDLF iletişim formu — ORTAM DEĞİŞKENLERİ (ÖRNEK)
# Bu dosya örnektir; gerçek anahtarı BURAYA YAZMAYIN ve COMMIT'LEMEYİN.
# Değerleri barındırma panelinizde (Vercel/Netlify) tanımlayın.

# Resend API anahtarınız (https://resend.com/api-keys) — ZORUNLU
RESEND_API_KEY=

# İletişim mesajlarının gideceği e-posta (varsayılan: info@gndlf.io)
CONTACT_TO=info@gndlf.io

# Gönderen adresi. Kendi alan adınızı Resend'de doğruladıktan sonra kullanın,
# örn: "GNDLF Web <noreply@gndlf.io>". Doğrulanana kadar test için:
CONTACT_FROM=GNDLF Web <onboarding@resend.dev>
